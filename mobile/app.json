{
  "expo": {
    "name": "Academia NG",
    "slug": "academia-ng",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "academiang",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F7F6",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.academia.app"
    },
    "android": {
      "package": "ng.academia.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
